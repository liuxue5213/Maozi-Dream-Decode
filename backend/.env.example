# 数据库
DATABASE_URL=postgresql://dream:dream2024@localhost:5432/dream_app

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_DAYS=30

# 阿里云百炼（自定义端点）
DASHSCOPE_API_KEY=sk-your-api-key-here
DASHSCOPE_MODEL=qwen-plus
# 自定义 MaaS 端点（如果是标准百炼则不需要修改）
DASHSCOPE_BASE_URL=https://llm-xxxxxx.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# 是否开启深度思考（部分模型支持）
DASHSCOPE_ENABLE_THINKING=false

# 服务器配置
ALLOWED_ORIGINS=*
